{
  "name": "paper-collage-promo",
  "version": "1.0.0",
  "private": true,
  "description": "纸质拼贴风产品宣传片模板 · Remotion",
  "license": "MIT",
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "fonts": "python3 scripts/fonts.py",
    "mix": "python3 scripts/mix.py",
    "stills": "node scripts/stills.mjs",
    "sheet": "python3 scripts/sheet.py",
    "check:assets": "python3 scripts/check_assets.py",
    "render": "remotion render Promo out/final-1080p.mp4 --crf=16 --concurrency=8",
    "render:4k": "remotion render Promo out/final-4k.mp4 --scale=2 --crf=16 --concurrency=6",
    "check": "python3 scripts/check_video.py out/final-1080p.mp4"
  },
  "sideEffects": [
    "*.css",
    "./src/lib/fonts.ts"
  ]
}
